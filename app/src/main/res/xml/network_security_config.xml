<?xml version="1.0" encoding="utf-8"?>
<!-- 내부 LAN / Proxmox / Unraid HTTP 서버 및 로컬 프록시(127.0.0.1) 통신 허용 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
